flowchart TD
    RX["every decoded frame"] --> SNR["SNR estimate"] --> REQ["rung request<br/>(RX-driven ladder)"]
    RX --> CFO["CFO measurement"] --> NET["AFC netting request"]
    RX --> BER["pre-FEC BER"] --> LOG["diagnostics"]

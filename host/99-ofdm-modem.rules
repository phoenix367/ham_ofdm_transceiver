# OFDM modem -- stable naming and non-root access.
#   sudo cp host/99-ofdm-modem.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
#
# The symlink is the whole point. A USB-serial bridge gives you
# /dev/ttyACM0 or ttyACM1 depending on what else was plugged in first,
# and nothing on the node says which one is the modem. Here each unit is
# named after its own serial -- the STM32's 96-bit unique ID -- so the
# name is stable across reboots and distinct between two modems on one
# machine:
#
#   /dev/ofdm-modem-240041000551333438363436
#   /dev/ofdm-modem       -> whichever enumerated first, for the common
#                            single-modem case
#
# TAG+="uaccess" hands the device to the logged-in user, which is how a
# desktop session should get it. MODE/GROUP are the fallback for headless
# machines, where uaccess does not apply.
#
# 1209:0001 is the pid.codes TEST id and is DEVELOPMENT ONLY. A shipped
# unit needs its own allocated product ID, and this rule must then be
# narrowed to it -- otherwise it claims every other prototype using the
# same test id.

SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="0001", ATTR{manufacturer}=="ofdm-transceiver-proto", TAG+="uaccess", MODE="0660", GROUP="plugdev", SYMLINK+="ofdm-modem-$attr{serial}", SYMLINK+="ofdm-modem"
